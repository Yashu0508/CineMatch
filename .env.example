APP_ENV=development
APP_LOG_LEVEL=INFO
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cinematch
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
TMDB_REGION=IN
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=v1
RECOMMENDER_MODE=hybrid
CONTENT_WEIGHT=0.45
COLLAB_WEIGHT=0.35
POPULARITY_WEIGHT=0.10
PREFERENCE_WEIGHT=0.10
ALLOWED_ORIGINS=http://localhost:3000
TMDB_CACHE_TTL_SECONDS=300

