APP_ENV=development
APP_LOG_LEVEL=INFO
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cinematch
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-avatars
OMDB_API_KEY=
OMDB_API_BASE_URL=https://www.omdbapi.com/
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=v1
RECOMMENDER_MODE=hybrid
CONTENT_WEIGHT=0.45
COLLAB_WEIGHT=0.35
POPULARITY_WEIGHT=0.10
PREFERENCE_WEIGHT=0.10
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OMDB_CACHE_TTL_SECONDS=300
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback
